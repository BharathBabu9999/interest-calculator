# Update this URL with your actual Render backend URL after deploying
# e.g. https://interest-calc-api.onrender.com
VITE_API_URL=https://interest-calc-api.onrender.com

# File uploads are disabled on Render's free tier (no persistent disk).
# Set to true only if you have a paid Render plan with a persistent volume mounted at /app/uploads
VITE_ENABLE_FILES=false
