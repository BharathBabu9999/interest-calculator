# Copy this file to .env and fill in your values
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/interest_calc
SECRET_KEY=your-long-random-secret-key-here

# Password reset emails via Gmail
# In Gmail: Settings → Security → 2-Step Verification → App Passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Frontend URL (used in reset email links)
FRONTEND_URL=http://localhost:5173

# Google OAuth — Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
